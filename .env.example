# Salin file ini menjadi .env lalu ubah nilainya (opsional untuk laptop).
# Di Vercel, isi nilai yang sama di: Settings > Environment Variables.

PORT=3000

# Database cloud Turso (WAJIB di Vercel). Kosongkan untuk pakai file lokal data/cafe.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Akun admin awal (dipakai HANYA saat database pertama kali dibuat)
# Di Vercel, ADMIN_PASSWORD wajib diisi (tidak ada password default).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
